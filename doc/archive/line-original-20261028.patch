+name: V3 Release - GHCR to Cloud Run
+
+on:
+  workflow_dispatch:
+    inputs:
+      promote:
+        description: "After candidate and Preview PASS, switch production traffic and run live gates"
+        required: true
+        default: false
+        type: boolean
+      publish_staging:
+        description: "Publish pinned Preview to staging with automated OAuth redirect checks; no manual Owner login"
+        required: true
+        default: false
+        type: boolean
+      enable_line:
+        description: "Enable configured LINE channel; uses STAGE or PROD variables according to promote"
+        required: true
+        default: false
+        type: boolean
+      enable_gmail_onnx:
+        description: "Enable offline Gmail ONNX image with 2Gi/2vCPU/one concurrency for staging and promotion"
+        required: true
+        default: false
+        type: boolean
+
+permissions:
+  contents: read
+  checks: read
+  actions: write
+  id-token: write
+  packages: write
+
+concurrency:
+  group: life-assistant-v3-production-release
+  cancel-in-progress: false
+
+jobs:
+  release:
+    runs-on: ubuntu-latest
+    timeout-minutes: 120
+    environment: dev-test
+    env:
+      GCP_PROJECT_ID: gen-lang-client-0593591102
+      GCP_REGION: us-central1
+      CLOUD_RUN_SERVICE: life-assistant-api
+      RELEASE_SHA: ${{ github.sha }}
+      GHCR_IMAGE: ghcr.io/tommylin15/life_assistant-backend
+      FRONTEND_URL: https://gen-lang-client-0593591102.web.app
+      STAGING_HOSTING_SITE: life-assistant-v3-stage-tl15
+      GH_TOKEN: ${{ github.token }}
+
+    steps:
+      - name: Checkout exact release commit
+        uses: actions/checkout@v4
+        with:
+          ref: ${{ github.sha }}
+          persist-credentials: false
+
+      - name: Guard main SHA and required CI success
+        shell: bash
+        run: |
+          set -euo pipefail
+          [[ "$RELEASE_SHA" =~ ^[0-9a-f]{40}$ ]]
+          test "$(git rev-parse HEAD)" = "$RELEASE_SHA"
+          MAIN_SHA="$(git ls-remote origin refs/heads/main | awk '{print $1}')"
+          test "$MAIN_SHA" = "$RELEASE_SHA"
+          gh api "repos/$GITHUB_REPOSITORY/commits/$RELEASE_SHA/check-runs?per_page=100" \
+            | jq -e '
+              [.check_runs[] | select(.name=="flutter" or .name=="backend" or .name=="deployment-scripts" or .name=="free-events-postgres" or .name=="gmail-onnx-image")
+               | select(.conclusion=="success") | .name] | unique | length == 5
+            '
+          echo "source=PASS sha=$RELEASE_SHA; required-ci=PASS" >> "$GITHUB_STEP_SUMMARY"
+
+
+      - name: Guard user-facing version and latest news before production
+        if: ${{ inputs.promote }}
+        shell: bash
+        run: |
+          set -euo pipefail
+          LIVE_SHA="$(curl --fail --silent --show-error --retry 3 \
+            -H 'Cache-Control: no-cache' \
+            "$FRONTEND_URL/release.txt?candidate=$RELEASE_SHA" | tr -d '\r\n')"
+          [[ "$LIVE_SHA" =~ ^[0-9a-f]{40}$ ]] || {
+            echo "::error::Cannot verify previous production SHA for version review"; exit 1;
+          }
+          git fetch --quiet --no-tags --depth=1 origin "$LIVE_SHA"
+          python scripts/check_user_release_metadata.py \
+            --base-sha "$LIVE_SHA" --head-sha "$RELEASE_SHA"
+          echo "user_release_metadata=PASS live=$LIVE_SHA candidate=$RELEASE_SHA" >> "$GITHUB_STEP_SUMMARY"
+
+      - name: Create isolated immutable Preview channel for this attempt
+        shell: bash
+        run: |
+          set -euo pipefail
+          [[ "$GITHUB_RUN_ID" =~ ^[1-9][0-9]*$ ]]
+          [[ "$GITHUB_RUN_ATTEMPT" =~ ^[1-9][0-9]*$ ]]
+          # Firebase's public channel hostname truncates channel identifiers
+          # beyond its 24-character prefix; validate before deploying.
+          # Base36 preserves the complete GitHub run ID without collisions.
+          RUN_KEY="$(python - "$GITHUB_RUN_ID" <<'PY'
+          import sys
+          n=int(sys.argv[1])
+          assert n > 0
+          alphabet="0123456789abcdefghijklmnopqrstuvwxyz"
+          value=""
+          while n:
+              value=alphabet[n%36]+value
+              n//=36
+          print(value)
+          PY
+          )"
+          CHANNEL="v3-${RELEASE_SHA:0:10}-${RUN_KEY}a${GITHUB_RUN_ATTEMPT}"
+          [[ ${#CHANNEL} -le 24 ]]
+          echo "PREVIEW_CHANNEL=$CHANNEL" >> "$GITHUB_ENV"
+          echo "preview_channel=$CHANNEL isolated_attempt=true" >> "$GITHUB_STEP_SUMMARY"
+
+      - name: Require fixed-staging acceptance for production promotion
+        if: ${{ inputs.promote && !inputs.publish_staging }}
+        run: |
+          echo "::error::Production promotion requires publish_staging and pinned staging readback"
+          exit 1
+
+      - name: Guard ONNX staging-only activation
+        shell: bash
+        run: |
+          set -euo pipefail
+          if [[ "${{ inputs.enable_gmail_onnx }}" == "true" ]]; then
+            test "${{ inputs.publish_staging }}" = "true"
+            echo "gmail_onnx_rollout=STAGING_AND_PRODUCTION_WITH_STANDARD_LIVE_GATES" >> "$GITHUB_STEP_SUMMARY"
+          fi
+
+      - name: Build Docker image ONCE on GitHub runner
+        run: |
+          set -euo pipefail
+          IMAGE_TAG="$RELEASE_SHA"
+          DOCKERFILE="backend/Dockerfile"
+          if [[ "${{ inputs.enable_gmail_onnx }}" == "true" ]]; then
+            IMAGE_TAG="${RELEASE_SHA}-gmail-onnx"
+            DOCKERFILE="backend/Dockerfile.gmail-semantic"
+          fi
+          echo "RELEASE_IMAGE_TAG=$IMAGE_TAG" >> "$GITHUB_ENV"
+          docker build --pull --platform linux/amd64 -f "$DOCKERFILE" -t "$GHCR_IMAGE:$IMAGE_TAG" backend
+          if [[ "${{ inputs.enable_gmail_onnx }}" == "true" ]]; then
+            docker run --rm --network none --memory 1g --cpus 2 --entrypoint python "$GHCR_IMAGE:$IMAGE_TAG" \
+              -m scripts.gmail_semantic_benchmark --report /tmp/gmail-synthetic.json --enforce-gates
+            echo "onnx_local_offline_smoke=PASS no_network" >> "$GITHUB_STEP_SUMMARY"
+          fi
+
+      - name: Scan local image before publishing
+        uses: aquasecurity/trivy-action@v0.36.0
+        with:
+          scan-type: image
+          image-ref: ${{ env.GHCR_IMAGE }}:${{ env.RELEASE_IMAGE_TAG }}
+          scanners: vuln,secret
+          exit-code: '1'
+          ignore-unfixed: true
+          severity: CRITICAL,HIGH
+
+      - name: Login to GHCR
+        uses: docker/login-action@v3
+        with:
+          registry: ghcr.io
+          username: ${{ github.actor }}
+          password: ${{ secrets.GITHUB_TOKEN }}
+
+      - name: Publish immutable GHCR manifest reference
+        id: publish
+        shell: bash
+        run: |
+          set -euo pipefail
+          docker push "$GHCR_IMAGE:$RELEASE_IMAGE_TAG"
+          IMAGE_REF="$(docker image inspect --format '{{index .RepoDigests 0}}' "$GHCR_IMAGE:$RELEASE_IMAGE_TAG")"
+          [[ "$IMAGE_REF" =~ ^ghcr[.]io/tommylin15/life_assistant-backend@sha256:[a-f0-9]{64}$ ]]
+          echo "ref=$IMAGE_REF" >> "$GITHUB_OUTPUT"
+          echo "IMAGE_REF=$IMAGE_REF" >> "$GITHUB_ENV"
+          echo "ghcr_digest=PASS ref=$IMAGE_REF" >> "$GITHUB_STEP_SUMMARY"
+
+      - name: Prove package and digest are anonymously pullable
+        run: |
+          set -euo pipefail
+          ANON_CONFIG="$(mktemp -d)"
+          DOCKER_CONFIG="$ANON_CONFIG" docker manifest inspect "$IMAGE_REF" >/dev/null
+          echo "ghcr_anonymous_pull=PASS" >> "$GITHUB_STEP_SUMMARY"
+
+      - name: Authenticate to GCP with deployer WIF
+        uses: google-github-actions/auth@v2
+        with:
+          project_id: ${{ env.GCP_PROJECT_ID }}
+          workload_identity_provider: ${{ secrets.GCP_WORKLOAD_IDENTITY_PROVIDER }}
+          service_account: ${{ secrets.GCP_DEPLOY_SERVICE_ACCOUNT }}
+
+      - name: Install gcloud
+        uses: google-github-actions/setup-gcloud@v2
+
+      - name: Capture pre-promotion traffic, service identity and images
+        run: |
+          set -euo pipefail
+          gcloud run services describe "$CLOUD_RUN_SERVICE" \
+            --project "$GCP_PROJECT_ID" --region "$GCP_REGION" --format=json \
+            > "$RUNNER_TEMP/v3-pre-service.json"
+          jq -e '.status.url and (.status.traffic | type=="array") and
+                 (.status.traffic | map(.percent // 0) | add == 100)' \
+            "$RUNNER_TEMP/v3-pre-service.json"
+          jq -r '.status.traffic[] | select((.percent // 0)>0) |
+                 "before_revision=\(.revisionName) percent=\(.percent)"' \
+            "$RUNNER_TEMP/v3-pre-service.json" >> "$GITHUB_STEP_SUMMARY"
+          PREVIOUS_REVISIONS="$(jq -r '[.status.traffic[] |
+                        select((.percent // 0)>0) |
+                        "\(.revisionName)=\(.percent)"] | join(",")' \
+                        "$RUNNER_TEMP/v3-pre-service.json")"
+          test -n "$PREVIOUS_REVISIONS"
+          echo "PREVIOUS_REVISIONS=$PREVIOUS_REVISIONS" >> "$GITHUB_ENV"
+          # Read-only capacity evidence for opt-in Gmail ONNX model sizing.
+          RAM="$(jq -r '.spec.template.spec.containers[0].resources.limits.memory // "NOT_VERIFIED"' "$RUNNER_TEMP/v3-pre-service.json")"
+          CPU="$(jq -r '.spec.template.spec.containers[0].resources.limits.cpu // "NOT_VERIFIED"' "$RUNNER_TEMP/v3-pre-service.json")"
+          echo "gmail_semantic_existing_service_capacity=memory:$RAM cpu:$CPU" >> "$GITHUB_STEP_SUMMARY"
+
+      - name: Create 0%-traffic digest-pinned candidate
+        id: candidate
+        env:
+          LINE_ENABLED: ${{ inputs.enable_line && 'true' || 'false' }}
+          LINE_NAMESPACE: ${{ vars[format('LINE_{0}_NAMESPACE', inputs.promote && 'PROD' || 'STAGE')] }}
+          LINE_ORIGIN: ${{ vars[format('LINE_{0}_ORIGIN', inputs.promote && 'PROD' || 'STAGE')] }}
+          LINE_LIFF_ID: ${{ vars[format('LINE_{0}_LIFF_ID', inputs.promote && 'PROD' || 'STAGE')] }}
+          LINE_LOGIN_CHANNEL_ID: ${{ vars[format('LINE_{0}_LOGIN_CHANNEL_ID', inputs.promote && 'PROD' || 'STAGE')] }}
+          LINE_CHANNEL_SECRET_REF: ${{ vars[format('LINE_{0}_CHANNEL_SECRET_REF', inputs.promote && 'PROD' || 'STAGE')] }}
+          LINE_ACCESS_TOKEN_REF: ${{ vars[format('LINE_{0}_ACCESS_TOKEN_REF', inputs.promote && 'PROD' || 'STAGE')] }}
+        shell: bash
+        run: |
+          set -euo pipefail
+          TAG="v3-$(printf '%s' "$RELEASE_SHA" | cut -c1-10)"
+          RESOURCE_FLAGS=()
+          if [[ "${{ inputs.enable_gmail_onnx }}" == "true" ]]; then
+            RESOURCE_FLAGS=(--cpu 2 --memory 2Gi --concurrency 1)
+          fi
+          python scripts/line_deploy_flags.py > "$RUNNER_TEMP/line-flags.bin"
+          mapfile -d '' -t LINE_FLAGS < "$RUNNER_TEMP/line-flags.bin"
+          gcloud run deploy "$CLOUD_RUN_SERVICE" \
+            --project "$GCP_PROJECT_ID" --region "$GCP_REGION" \
+            --image "$IMAGE_REF" --no-traffic --tag "$TAG" "${RESOURCE_FLAGS[@]}" "${LINE_FLAGS[@]}" --quiet
+          gcloud run services describe "$CLOUD_RUN_SERVICE" \
+            --project "$GCP_PROJECT_ID" --region "$GCP_REGION" --format=json \
+            > "$RUNNER_TEMP/v3-candidate-service.json"
+          REVISION="$(jq -r '.status.latestReadyRevisionName' "$RUNNER_TEMP/v3-candidate-service.json")"
+          URL="$(jq -r --arg tag "$TAG" '.status.traffic[] |
+                   select(.tag==$tag) | .url' "$RUNNER_TEMP/v3-candidate-service.json")"
+          test -n "$REVISION" && test -n "$URL"
+          jq -e --arg rev "$REVISION" --arg tag "$TAG" \
+            '[.status.traffic[] |
+             select((.revisionName==$rev) and ((.percent // 0)==0) and (.tag==$tag))] | length==1' \
+             "$RUNNER_TEMP/v3-candidate-service.json"
+          gcloud run revisions describe "$REVISION" \
+            --project "$GCP_PROJECT_ID" --region "$GCP_REGION" --format=json \
+            > "$RUNNER_TEMP/v3-candidate-revision.json"
+          python .github/scripts/v3_image_identity.py \
+            --resource revision \
+            --json "$RUNNER_TEMP/v3-candidate-revision.json" \
+            --expected "$IMAGE_REF"
+          echo "revision=$REVISION" >> "$GITHUB_OUTPUT"
+          echo "url=$URL" >> "$GITHUB_OUTPUT"
+          echo "CANDIDATE_REVISION=$REVISION" >> "$GITHUB_ENV"
+          echo "candidate=PASS revision=$REVISION traffic=0 digest=$IMAGE_REF" >> "$GITHUB_STEP_SUMMARY"
+
+      - name: Candidate health, database readiness, auth and authorization
+        shell: bash
+        run: |
+          set -euo pipefail
+          URL="${{ steps.candidate.outputs.url }}"
+          # Each probe prints ONLY its phase and HTTP code (never OAuth headers,
+          # cookies or state). Retry transient Cloud Run cold-start/DB-readiness
+          # responses with a strict bound; do not downgrade auth requirements.
+          probe() {
+            local label="$1" path="$2" expected="$3"
+            local attempt code
+            for attempt in 1 2 3 4 5 6 7 8; do
+              code="$(curl --silent --show-error --max-time 15 \
+                --dump-header "$RUNNER_TEMP/v3-candidate-$label.headers" \
+                --output /dev/null --write-out '%{http_code}' \
+                "$URL$path")" || code="000"
+              if [[ "$code" == "$expected" ]]; then
+                echo "candidate_$label=PASS http=$code attempt=$attempt"
+                return 0
+              fi
+              if [[ "$code" == 000 || "$code" == 404 || "$code" == 429 || "$code" =~ ^5[0-9]{2}$ ]]; then
+                if [[ "$attempt" != 8 ]]; then
+                  echo "candidate_$label=RETRY http=$code attempt=$attempt"
+                  sleep 3
+                  continue
+                fi
+              fi
+              echo "::error::candidate_$label=FAIL http=$code expected=$expected attempt=$attempt"
+              return 1
+            done
+          }
+          probe health /health 200
+          probe ready /ready 200
+          probe unauthorized /api/v1/tasks 401
+          probe oauth /auth/login 307
+          python - "$RUNNER_TEMP/v3-candidate-oauth.headers" <<'PY'
+          from pathlib import Path
+          from urllib.parse import parse_qs, urlsplit
+          import sys
+          # Never log or export this header: it contains a temporary OAuth state.
+          lines = Path(sys.argv[1]).read_text(encoding="utf-8").splitlines()
+          location = next((line.split(":", 1)[1].strip() for line in lines
+                           if line.lower().startswith("location:")), "")
+          target = urlsplit(location)
+          params = parse_qs(target.query)
+          # Candidate is a SHA-pinned Cloud Run tag (the same origin used by
+          # fixed Staging Hosting). Never require its Google redirect to point
+          # at the production session domain.
+          expected = "https://life-assistant-v3-stage-tl15.web.app/auth/callback"
+          if not (target.scheme == "https" and target.hostname == "accounts.google.com"
+                  and target.path == "/o/oauth2/v2/auth"
+                  and params.get("redirect_uri") == [expected]
+                  and len(params.get("state", [""])[0]) >= 32):
+              raise SystemExit("::error::candidate_oauth=FAIL google_host_callback_or_state")
+          print("candidate_oauth_redirect=PASS google_host=PINNED callback=PINNED state=PRESENT")
+          PY
+          if [[ "${{ inputs.enable_gmail_onnx }}" == "true" ]]; then
+            curl --fail --silent --show-error --max-time 30 "$URL/ready" \
+              | jq -e '.status=="ok" and .database=="ok" and .gmail_model=="local_semantic_ready"' > /dev/null
+            test "$(curl --silent --show-error --max-time 15 --output /dev/null --write-out '%{http_code}' "$URL/api/v1/integrations/google/gmail/radar/status")" = 401
+            echo "candidate_full_life_onnx=PASS db=READY semantic_model=READY owner_auth=ENFORCED" >> "$GITHUB_STEP_SUMMARY"
+          fi
+          echo "candidate_http=PASS health,ready,401,oauth-redirect" >> "$GITHUB_STEP_SUMMARY"
+
+      - name: Pin migration job to same immutable release digest (do not execute)
+        if: ${{ inputs.promote || inputs.publish_staging }}
+        shell: bash
+        run: |
+          set -euo pipefail
+          gcloud run jobs update life-assistant-db-migrate \
+            --project "$GCP_PROJECT_ID" --region "$GCP_REGION" \
+            --image "$IMAGE_REF" --quiet
+          gcloud run jobs describe life-assistant-db-migrate \
+            --project "$GCP_PROJECT_ID" --region "$GCP_REGION" --format=json \
+            > "$RUNNER_TEMP/v3-migration-job.json"
+          python .github/scripts/v3_image_identity.py \
+            --resource job \
+            --json "$RUNNER_TEMP/v3-migration-job.json" \
+            --expected "$IMAGE_REF"
+          echo "migration_job_image=PASS no_migration_executed image=$IMAGE_REF" \
+            >> "$GITHUB_STEP_SUMMARY"
+
+      - name: Apply additive 0018 schema before staging or production cutover
+        if: ${{ inputs.promote || inputs.publish_staging }}
+        shell: bash
+        run: |
+          set -euo pipefail
+          # Migrations 0011 through 0018 are additive; guarded runner checks actual head.
+          .github/scripts/run_cloud_run_job_with_diagnostics.sh life-assistant-db-migrate \
+            gcloud run jobs execute life-assistant-db-migrate \
+            --project "$GCP_PROJECT_ID" --region "$GCP_REGION" \
+            --args=-m,scripts.apply_cloud_domain_parity_release \
+            --task-timeout 10m --wait --quiet
+          echo "migration_job=PASS (DB revision independently checked below)" >> "$GITHUB_STEP_SUMMARY"
+
+      - name: Verify Gmail V2 actual PostgreSQL schema readback
+        if: ${{ inputs.promote || inputs.publish_staging }}
+        shell: bash
+        run: |
+          set -euo pipefail
+          .github/scripts/run_cloud_run_job_with_diagnostics.sh life-assistant-db-migrate \
+            gcloud run jobs execute life-assistant-db-migrate \
+            --project "$GCP_PROJECT_ID" --region "$GCP_REGION" \
+            --args=-m,scripts.gmail_v2_db_acceptance \
+            --task-timeout 5m --wait --quiet
+          echo "gmail_v2_db_readback=PASS revision=20261019_0022 (job exit only)" >> "$GITHUB_STEP_SUMMARY"
+
+      - name: Set up Flutter for candidate Hosting Preview
+        uses: subosito/flutter-action@v2
+        with:
+          flutter-version: '3.47.3'
+          channel: stable
+          cache: true
+
+      - name: Prepare Flutter Preview and pin rewrites to candidate
+        shell: bash
+        run: |
+          set -euo pipefail
+          python -m pip install --disable-pip-version-check pillow==11.3.0
+          python scripts/prepare_branding_assets.py
+          flutter pub get
+          APP_VERSION="$(sed -nE 's/^version: ([0-9]+\.[0-9]+\.[0-9]+)\+[0-9]+$/\1/p' pubspec.yaml)"
+          test -n "$APP_VERSION"
+          flutter build web --target=lib/main_web.dart --no-pub \
+            --dart-define="LIFE_APP_VERSION=$APP_VERSION" \
+            --dart-define="LIFE_RELEASE_SHA=$RELEASE_SHA"
+          printf '%s\n' "$RELEASE_SHA" > build/web/release.txt
+          python - <<'PY'
+          import json
+          from pathlib import Path
+          import os
+          p = Path("firebase.json")
+          cfg = json.loads(p.read_text())
+          site = os.environ["STAGING_HOSTING_SITE"]
+          assert site == "life-assistant-v3-stage-tl15" and site != os.environ["GCP_PROJECT_ID"]
+          cfg["hosting"]["site"] = site
+          for item in cfg["hosting"]["rewrites"]:
+              if item.get("run", {}).get("serviceId") == "life-assistant-api":
+                  item["run"]["pinTag"] = True
+          p.write_text(json.dumps(cfg, indent=2) + "\n")
+          PY
+
+      - name: Confirm separate staging Hosting Site exists
+        shell: bash
+        run: |
+          set -euo pipefail
+          test "$STAGING_HOSTING_SITE" = "life-assistant-v3-stage-tl15"
+          test "$STAGING_HOSTING_SITE" != "$GCP_PROJECT_ID"
+          TOKEN="$(gcloud auth print-access-token)"
+          CODE="$(curl -sS -o "$RUNNER_TEMP/v3-stage-site-get.json" -w '%{http_code}' \
+            -H "Authorization: Bearer $TOKEN" \
+            "https://firebasehosting.googleapis.com/v1beta1/projects/$GCP_PROJECT_ID/sites/$STAGING_HOSTING_SITE")"
+          test "$CODE" = 200
+          jq -e --arg site "$STAGING_HOSTING_SITE" '.name | endswith("/sites/"+$site)' "$RUNNER_TEMP/v3-stage-site-get.json"
+
+      - name: Deploy preview channel (not production Hosting)
+        run: |
+          set -euo pipefail
+          npm install --global firebase-tools
+          CHANNEL="$PREVIEW_CHANNEL"
+          set +e
+          firebase hosting:channel:deploy "$CHANNEL" \
+            --expires 1d --project "$GCP_PROJECT_ID" --no-authorized-domains --json \
+            > "$RUNNER_TEMP/v3-hosting-preview.json" \
+            2> "$RUNNER_TEMP/v3-hosting-preview-stderr"
+          CODE=$?
+          set -e
+          if [ "$CODE" -ne 0 ]; then
+            python .github/scripts/v3_firebase_error.py \
+              "$RUNNER_TEMP/v3-hosting-preview.json" \
+              "$RUNNER_TEMP/v3-hosting-preview-stderr" "$CODE" \
+              | tee -a "$GITHUB_STEP_SUMMARY"
+            echo "::error::Firebase pinned Preview deployment failed; provider message withheld"
+            exit 1
+          fi
+          PREVIEW="$(jq -r '[.. | objects | .url? // empty |
+                     select(type=="string" and (contains("web.app") or contains("firebaseapp.com")))] |
+                     first // empty' "$RUNNER_TEMP/v3-hosting-preview.json")"
+          test -n "$PREVIEW"
+          echo "PREVIEW_URL=$PREVIEW" >> "$GITHUB_ENV"
+          echo "preview_url=$PREVIEW" >> "$GITHUB_STEP_SUMMARY"
+
+      - name: Verify Hosting preview channel release metadata
+        shell: bash
+        run: |
+          set -euo pipefail
+          CHANNEL="$PREVIEW_CHANNEL"
+          TOKEN="$(gcloud auth print-access-token)"
+          URL="https://firebasehosting.googleapis.com/v1beta1/sites/$STAGING_HOSTING_SITE/channels/$CHANNEL"
+          CODE=""
+          for n in 1 2 3 4 5 6 7 8; do
+            CODE="$(curl --silent --show-error --max-time 15 \
+              --output "$RUNNER_TEMP/v3-channel-release.json" \
+              --write-out '%{http_code}' \
+              -H "Authorization: Bearer $TOKEN" "$URL")" || CODE="000"
+            [[ "$CODE" == 200 ]] && break
+            if [[ "$CODE" != 404 && "$CODE" != 429 && "$CODE" != 000 && ! "$CODE" =~ ^5[0-9]{2}$ ]]; then
+              echo "::error::Preview channel metadata HTTP=$CODE" >&2
+              exit 1
+            fi
+            [[ "$n" == 8 ]] || sleep 3
+          done
+          if [[ "$CODE" != 200 ]]; then
+            echo "::error::Preview channel metadata unavailable HTTP=$CODE" >&2
+            exit 1
+          fi
+          python - "$RUNNER_TEMP/v3-channel-release.json" <<'PY'
+          import json,os,re,sys
+          doc=json.load(open(sys.argv[1]))
+          site=os.environ["STAGING_HOSTING_SITE"]
+          sha=os.environ["RELEASE_SHA"]
+          channel=os.environ["PREVIEW_CHANNEL"]
+          assert re.fullmatch(r"v3-"+re.escape(sha[:10])+r"-[0-9a-z]{1,8}a[1-9][0-9]*", channel)
+          assert len(channel) <= 24
+          assert doc.get("name")==f"sites/{site}/channels/{channel}"
+          url=doc.get("url","")
+          assert url==os.environ["PREVIEW_URL"].rstrip("/")
+          release=doc.get("release") or {}
+          version=(release.get("version") or {}).get("name","")
+          assert version.startswith(f"sites/{site}/versions/")
+          assert release.get("type") != "SITE_DISABLE"
+          print("preview_hosting_metadata=PASS site_and_channel=PINNED version=PUBLISHED")
+          PY
+          # Do not log tokens or raw Firebase resource JSON.
+
+      - name: Verify pinned Preview API and static release
+        run: |
+          set -euo pipefail
+          # Both official Firebase channel domains are checked. Only the
+          # domain serving the exact SHA AND unauthenticated API 401 can be used.
+          python scripts/v3_verify_preview.py |
+            tee "$RUNNER_TEMP/v3-preview-verified.txt"
+          VERIFIED_URL="$(sed -n 's/^preview_selected_url=//p'             "$RUNNER_TEMP/v3-preview-verified.txt" | tail -n 1)"
+          test -n "$VERIFIED_URL"
+          export PREVIEW_URL="$VERIFIED_URL"
+          echo "PREVIEW_URL=$PREVIEW_URL" >> "$GITHUB_ENV"
+          # Probe the real Firebase -> Cloud Run rewrite BEFORE touching staging
+          # live; the stage OAuth entrypoint must work even when the proxy
+          # hides the original Host / X-Forwarded-Host. No Google login follows.
+          curl --fail --silent --show-error --dump-header "$RUNNER_TEMP/stage-oauth-preview-headers" \
+            --output /dev/null "$PREVIEW_URL/auth/staging/login"
+          grep -Eiq '^location: https://accounts[.]google[.]com/o/oauth2/' \
+            "$RUNNER_TEMP/stage-oauth-preview-headers"
+          grep -Fq 'redirect_uri=https%3A%2F%2Flife-assistant-v3-stage-tl15.web.app%2Fauth%2Fcallback' \
+            "$RUNNER_TEMP/stage-oauth-preview-headers"
+          grep -Eiq '^set-cookie: __session=' "$RUNNER_TEMP/stage-oauth-preview-headers"
+          grep -Fq 'oauth:staging:' "$RUNNER_TEMP/stage-oauth-preview-headers"
+          echo "preview=PASS release-sha=$RELEASE_SHA 401-protected stage-oauth-rewrite-and-state=PASS" >> "$GITHUB_STEP_SUMMARY"
+
+      - name: Read-only fixed staging preview and rollback baseline preflight
+        if: ${{ inputs.publish_staging }}
+        shell: bash
+        run: bash scripts/v3_fixed_staging_release.sh --preflight-only
+
+      - name: Promote exact Preview to independent fixed staging live and verify pinned routes
+        id: staging_live
+        if: ${{ inputs.publish_staging }}
+        shell: bash
+        run: bash scripts/v3_fixed_staging_release.sh
+
+      - name: Require explicit promotion selection
+        if: ${{ !inputs.promote }}
+        run: echo "PROMOTION=NOT REQUESTED; production traffic unchanged" >> "$GITHUB_STEP_SUMMARY"
+
+      - name: Reconfirm source SHA and live traffic, then promote
+        id: promote_live
+        if: ${{ inputs.promote }}
+        shell: bash
+        run: |
+          set -euo pipefail
+          test "$(git ls-remote origin refs/heads/main | awk '{print $1}')" = "$RELEASE_SHA"
+          gcloud run services describe "$CLOUD_RUN_SERVICE" \
+            --project "$GCP_PROJECT_ID" --region "$GCP_REGION" --format=json \
+            > "$RUNNER_TEMP/v3-before-promotion.json"
+          jq -e --slurpfile previous "$RUNNER_TEMP/v3-pre-service.json" \
+            '(.status.traffic |
+              map(select((.percent // 0)>0) | {revisionName, percent:(.percent // 0)})) ==
+             ($previous[0].status.traffic |
+              map(select((.percent // 0)>0) | {revisionName, percent:(.percent // 0)}))' \
+            "$RUNNER_TEMP/v3-before-promotion.json"
+          gcloud run services update-traffic "$CLOUD_RUN_SERVICE" \
+            --project "$GCP_PROJECT_ID" --region "$GCP_REGION" \
+            --to-revisions="$CANDIDATE_REVISION=100" --quiet
+          echo "promotion=ATTEMPTED revision=$CANDIDATE_REVISION" >> "$GITHUB_STEP_SUMMARY"
+
+      - name: Post-promotion live health, PostgreSQL and access gates
+        id: live_acceptance
+        if: ${{ inputs.promote }}
+        shell: bash
+        run: |
+          set -euo pipefail
+          SERVICE_URL="$(jq -r '.status.url' "$RUNNER_TEMP/v3-pre-service.json")"
+          test -n "$SERVICE_URL"
+          curl --fail --silent --show-error --retry 5 "$SERVICE_URL/health" >/dev/null
+          curl --fail --silent --show-error --retry 3 "$SERVICE_URL/ready" >/dev/null
+          test "$(curl -s -o /dev/null -w '%{http_code}' "$SERVICE_URL/api/v1/tasks")" = 401
+          test "$(curl -s -o /dev/null -w '%{http_code}' "$SERVICE_URL/api/v1/free-events")" = 401
+          curl -sS -D "$RUNNER_TEMP/v3-live-login-headers" -o /dev/null \
+            "$FRONTEND_URL/auth/login"
+          grep -Fq 'redirect_uri=https%3A%2F%2Fgen-lang-client-0593591102.web.app%2Fauth%2Fcallback' \
+            "$RUNNER_TEMP/v3-live-login-headers"
+          gcloud run services describe "$CLOUD_RUN_SERVICE" \
+            --project "$GCP_PROJECT_ID" --region "$GCP_REGION" --format=json \
+            | jq -e --arg rev "$CANDIDATE_REVISION" \
+                '[.status.traffic[] | select(.revisionName==$rev and .percent==100)] | length==1'
+          echo "live=PASS health,ready,401,oauth-redirect" >> "$GITHUB_STEP_SUMMARY"
+
+      - name: Controlled rollback rehearsal and restore promoted live traffic
+        id: rollback_drill
+        if: ${{ inputs.promote && success() }}
+        shell: bash
+        run: |
+          set -euo pipefail
+          test -n "$PREVIOUS_REVISIONS"
+          SERVICE_URL="$(jq -r '.status.url' "$RUNNER_TEMP/v3-pre-service.json")"
+          gcloud run services update-traffic "$CLOUD_RUN_SERVICE" \
+            --project "$GCP_PROJECT_ID" --region "$GCP_REGION" \
+            --to-revisions="$PREVIOUS_REVISIONS" --quiet
+          gcloud run services describe "$CLOUD_RUN_SERVICE" \
+            --project "$GCP_PROJECT_ID" --region "$GCP_REGION" --format=json \
+            | jq -e --slurpfile previous "$RUNNER_TEMP/v3-pre-service.json" \
+                '([.status.traffic[] | select((.percent // 0)>0) |
+                   {revisionName, percent}] | sort_by(.revisionName)) ==
+                 ([$previous[0].status.traffic[] | select((.percent // 0)>0) |
+                   {revisionName, percent}] | sort_by(.revisionName))'
+          curl -fsS --retry 5 "$SERVICE_URL/health" >/dev/null
+          curl -fsS --retry 5 "$SERVICE_URL/ready" >/dev/null
+          test "$(curl -sS -o /dev/null -w '%{http_code}' "$SERVICE_URL/api/v1/tasks")" = 401
+          echo "rollback_drill=PASS baseline=$PREVIOUS_REVISIONS" >> "$GITHUB_STEP_SUMMARY"
+          gcloud run services update-traffic "$CLOUD_RUN_SERVICE" \
+            --project "$GCP_PROJECT_ID" --region "$GCP_REGION" \
+            --to-revisions="$CANDIDATE_REVISION=100" --quiet
+          gcloud run services describe "$CLOUD_RUN_SERVICE" \
+            --project "$GCP_PROJECT_ID" --region "$GCP_REGION" --format=json \
+            | jq -e --arg rev "$CANDIDATE_REVISION" \
+                '[.status.traffic[] | select(.revisionName==$rev and .percent==100)] | length==1'
+          curl -fsS --retry 5 "$SERVICE_URL/ready" >/dev/null
+          echo "re_promotion_after_rollback=PASS revision=$CANDIDATE_REVISION" >> "$GITHUB_STEP_SUMMARY"
+
+      - name: Restore original Cloud Run traffic on failed live gate
+        if: ${{ failure() && inputs.promote && steps.candidate.outcome == 'success' }}
+        shell: bash
+        run: |
+          set -euo pipefail
+          test -f "$RUNNER_TEMP/v3-pre-service.json"
+          ACTUAL="$(gcloud run services describe "$CLOUD_RUN_SERVICE" \
+            --project "$GCP_PROJECT_ID" --region "$GCP_REGION" --format=json)"
+          if printf '%s' "$ACTUAL" | jq -e --arg rev "$CANDIDATE_REVISION" \
+            '[.status.traffic[] | select(.revisionName==$rev and (.percent // 0)==100)] | length==1' >/dev/null; then
+            gcloud run services update-traffic "$CLOUD_RUN_SERVICE" \
+              --project "$GCP_PROJECT_ID" --region "$GCP_REGION" \
+              --to-revisions="$PREVIOUS_REVISIONS" --quiet
+            echo "automatic_rollback=ATTEMPTED original=$PREVIOUS_REVISIONS" >> "$GITHUB_STEP_SUMMARY"
+          else
+            echo "automatic_rollback=NOT_APPLIED traffic does not match this release; manual review required" >> "$GITHUB_STEP_SUMMARY"
+          fi
+
+      - name: Retain latest 10 revisions after all live gates PASS
+        id: revision_retention
+        if: ${{ inputs.promote && success() }}
+        shell: bash
+        run: |
+          set -euo pipefail
+          mapfile -t PREVIOUS_PROTECTED < <(jq -r '.status.traffic[] |
+            select((.percent // 0)>0) | .revisionName' "$RUNNER_TEMP/v3-pre-service.json")
+          PROTECT_ARGS=()
+          for OLD_REV in "${PREVIOUS_PROTECTED[@]}"; do
+            PROTECT_ARGS+=(--protect "$OLD_REV")
+          done
+          python .github/scripts/v3_revision_retention.py \
+            --project "$GCP_PROJECT_ID" --region "$GCP_REGION" \
+            --service "$CLOUD_RUN_SERVICE" --keep 10 \
+            --expected-live-revision "$CANDIDATE_REVISION" \
+            "${PROTECT_ARGS[@]}" --apply --live-passed \
+            | tee "$RUNNER_TEMP/v3-retention.json"
+          jq -r '"revision_retention=\(.status) remaining=\(.remaining_count) deleted=\(.deleted | length)"' \
+            "$RUNNER_TEMP/v3-retention.json" >> "$GITHUB_STEP_SUMMARY"
+
+      - name: Pin curated handoff Job after verified production promotion
+        id: curated_handoff
+        if: ${{ inputs.promote && success() }}
+        shell: bash
+        run: |
+          set -euo pipefail
+          HANDOFF_JOB=life-assistant-free-events
+          # The daily importer no longer updates image/command/env. Only a
+          # successful promoted production release may reconcile its Job.
+          gcloud run services describe "$CLOUD_RUN_SERVICE" \
+            --project "$GCP_PROJECT_ID" --region "$GCP_REGION" --format=json \
+            > "$RUNNER_TEMP/handoff-live-service.json"
+          gcloud run revisions describe "$CANDIDATE_REVISION" \
+            --project "$GCP_PROJECT_ID" --region "$GCP_REGION" --format=json \
+            > "$RUNNER_TEMP/handoff-live-revision.json"
+          python .github/scripts/v3_curated_handoff_alignment.py \
+            --mode live --json "$RUNNER_TEMP/handoff-live-service.json" \
+            --revision-json "$RUNNER_TEMP/handoff-live-revision.json" \
+            --expected-revision "$CANDIDATE_REVISION" --expected-image "$IMAGE_REF"
+          # Existing Job must be present; never create a new service or job.
+          gcloud run jobs describe "$HANDOFF_JOB" \
+            --project "$GCP_PROJECT_ID" --region "$GCP_REGION" --format=json \
+            > "$RUNNER_TEMP/handoff-job-before.json"
+          gcloud run jobs update "$HANDOFF_JOB" \
+            --project "$GCP_PROJECT_ID" --region "$GCP_REGION" \
+            --image "$IMAGE_REF" --command python \
+            --args=-m,scripts.import_curated_from_sheet \
+            --update-env-vars=LIFE_CURATED_SHEET_ID=1OZdQPmypZ1zwB65K4oQOr3VBGP2GAFMmBnZsqAW5ob4,LIFE_CURATED_IMPORT_APPLY=1 \
+            --quiet
+          gcloud run jobs describe "$HANDOFF_JOB" \
+            --project "$GCP_PROJECT_ID" --region "$GCP_REGION" --format=json \
+            > "$RUNNER_TEMP/handoff-job-after.json"
+          python .github/scripts/v3_curated_handoff_alignment.py \
+            --mode job --json "$RUNNER_TEMP/handoff-job-after.json" \
+            --expected-image "$IMAGE_REF"
+          echo "curated_handoff_image=PASS source=promoted-production-digest job=$HANDOFF_JOB execution=NOT_RUN" >> "$GITHUB_STEP_SUMMARY"
+
+      - name: Publish stage verdict
+        if: always()
+        run: |
+          echo "run=$GITHUB_RUN_ID sha=$RELEASE_SHA promote=${{ inputs.promote }} onnx_staging=${{ inputs.enable_gmail_onnx }}" \
+            >> "$GITHUB_STEP_SUMMARY"
+          echo "Legacy Cloud Build and GCS/AR deletion are separately gated; NOT VERIFIED until readback." \
+            >> "$GITHUB_STEP_SUMMARY"
+
+      # The cleanup is a separate maintenance outcome, not an OAuth, DB,
+      # traffic-promotion or Hosting release gate.
+      - name: Retire old Cloud Run revisions after successful V3 gates
+        id: retire_revisions
+        if: ${{ success() && inputs.publish_staging && !inputs.enable_gmail_onnx }}
+        continue-on-error: true
+        shell: bash
+        run: |
+          set -euo pipefail
+          CURRENT_MAIN="$(git ls-remote origin refs/heads/main | awk '{print $1}')"
+          if [[ "$CURRENT_MAIN" != "$RELEASE_SHA" ]]; then
+            echo "retirement=SUPERSEDED previous_sha=$RELEASE_SHA current_main=$CURRENT_MAIN" >> "$GITHUB_STEP_SUMMARY"
+            echo "retirement=SUPERSEDED" >> "$GITHUB_OUTPUT"
+            exit 0
+          fi
+          python3 .github/scripts/life_cloud_run_retirement_apply.py \
+            --project "$GCP_PROJECT_ID" --region "$GCP_REGION" --apply \
+            | tee "$RUNNER_TEMP/life-retirement-result.jsonl"
