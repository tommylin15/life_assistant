+            and authenticated_session
+            and not confirmation_satisfied(
+                request.method,
+                request.url.path,
+                request.headers.get(CONFIRMATION_HEADER),
+            )
+        ):
+            response = JSONResponse(
+                status_code=409,
+                content={
