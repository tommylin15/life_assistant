+IDENTITY = 'U' + 'a' * 32
+ENV = dict(LIFE_LINE_ENABLED='true', LIFE_LINE_NAMESPACE='test', LIFE_LINE_ORIGIN=ORIGIN,
+           LIFE_LINE_LIFF_ID='123-test', LIFE_LINE_LOGIN_CHANNEL_ID='123',
