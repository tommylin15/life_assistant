+            tests/test_v3_free_event_retirement_readback.py \
+            -v
+
+  gmail-onnx-image:
+    runs-on: ubuntu-latest
+    timeout-minutes: 35
+    steps:
+      - uses: actions/checkout@v4
+      - name: Build ONNX image and verify offline inference
+        run: |
+          docker build --pull --platform linux/amd64 -f backend/Dockerfile.gmail-semantic -t life-gmail-onnx:ci backend
