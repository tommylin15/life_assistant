+          export DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/free_events_precreated_ci
+          alembic upgrade 20261007_0010
+          python - <<'PY'
+          import asyncio
+          from app.db.session import Base, engine
