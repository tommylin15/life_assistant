+          async def simulate_old_api():
+              async with engine.begin() as conn:
+                  await conn.run_sync(Base.metadata.create_all)
+          asyncio.run(simulate_old_api())
+          PY
+          alembic upgrade 20261009_0014
+          python - <<'PY'
+          import asyncio
+          from sqlalchemy import text
+          from app.db.session import engine
+          async def verify():
+              async with engine.connect() as conn:
+                  assert await conn.scalar(text('SELECT version_num FROM alembic_version')) == '20261009_0014'
+                  assert await conn.scalar(text("""SELECT count(*) FROM pg_catalog.pg_tables WHERE schemaname='public' AND tablename LIKE 'free_event_%'""")) == 9
+              print('precreated_schema_reconciliation=PASS')
+          asyncio.run(verify())
+          PY
+
+  deployment-scripts:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+
+      - uses: actions/setup-python@v5
+        with:
+          python-version: '3.12'
+
+      - name: Validate GitHub Actions YAML
+        run: |
+          python -m pip install --disable-pip-version-check "PyYAML==6.0.2"
+          python - <<'PY'
+          from pathlib import Path
+          import yaml
+          for path in sorted(Path(".github/workflows").glob("*.yml")):
+              data=yaml.safe_load(path.read_text(encoding="utf-8"))
+              assert isinstance(data, dict) and "jobs" in data, path
+              assert isinstance(data["jobs"], dict) and data["jobs"], path
+          print("workflow_yaml_syntax=PASS")
+          PY
+
+      - name: Validate script syntax
+        run: |
+          # Shell scripts
+          bash -n scripts/bootstrap_gcp_wif.sh
