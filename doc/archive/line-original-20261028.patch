+:root{font-family:system-ui,-apple-system,"Noto Sans TC",sans-serif;color:#183c35;background:#f4f7f3;font-size:16px}*{box-sizing:border-box}body{max-width:760px;margin:auto;padding:20px 16px 40px}header{padding:18px 4px}small{letter-spacing:.16em;color:#56726a}h1{font-size:1.9rem;line-height:1.25;margin:10px 0}h2{font-size:1.25rem}p{line-height:1.6;white-space:pre-wrap;overflow-wrap:anywhere}nav{display:flex;gap:8px;overflow-x:auto;padding:8px 0 16px}button,a.button{border:1px solid #bacbc3;border-radius:12px;padding:12px 15px;background:#fff;color:#183c35;font:inherit;cursor:pointer;white-space:nowrap;text-decoration:none;display:inline-block}button.primary{background:#185b48;color:#fff;border-color:#185b48}button:disabled{opacity:.5;cursor:wait}button.active{background:#dbece3}section,article{background:white;border:1px solid #dce5df;border-radius:18px;padding:18px;margin:12px 0;box-shadow:0 2px 8px #123b3010}label{display:block;margin:14px 0 6px;font-weight:600}input,textarea,select{display:block;width:100%;font:inherit;border:1px solid #a8bcb1;border-radius:10px;padding:12px;background:#fff;color:#183c35}textarea{min-height:110px;resize:vertical}input[type=checkbox]{display:inline;width:auto;margin-right:10px;transform:scale(1.2)}.actions{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px}.muted,footer{font-size:.85rem;color:#586f67}.error{color:#9d2828}#status{margin:4px;min-height:24px}a{color:#185b48}code{overflow-wrap:anywhere;white-space:pre-wrap}footer{padding-top:24px}button:focus-visible,a:focus-visible{outline:3px solid #e4af42;outline-offset:2px}
