+name: CI
+
+on:
+  workflow_dispatch:
+  push:
+    branches: [main]
+  pull_request:
+    branches: [main]
+
+jobs:
+  flutter:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+
+      - uses: actions/setup-python@v5
+        with:
+          python-version: '3.12'
+          cache: pip
+          cache-dependency-path: '**/requirements*.txt'
+
+      - name: Prepare and verify branding assets
+        run: |
+          python -m pip install --disable-pip-version-check pillow==11.3.0
+          python -m unittest tests/test_branding_assets.py -v
+          python scripts/prepare_branding_assets.py
+          python - <<'PY'
+          from PIL import Image
+          from pathlib import Path
+          checks = {
+              'web/icons/life-assistant-192-v8.png': (192, 192),
+              'web/icons/life-assistant-512-v8.png': (512, 512),
+              'web/branding/life-assistant-hero-v8.png': (1024, 1024),
+              'android/app/src/main/res/drawable/life_assistant_icon.png': (1024, 1024),
+          }
+          for name, expected in checks.items():
+              path = Path(name)
+              assert path.is_file() and path.stat().st_size > 4000, name
+              with Image.open(path) as image:
+                  assert image.format == 'PNG' and image.size == expected, (name, image.size)
+          print('branding_assets=PASS')
+          PY
+
+      - uses: subosito/flutter-action@v2
+        with:
+          flutter-version: '3.47.3'
+          channel: stable
+          cache: true
+
+      - name: Flutter CI
+        run: |
+          flutter pub get
+          flutter analyze --no-pub --no-fatal-infos
+          flutter test --no-pub --reporter expanded
+          flutter build web --target=lib/main_web.dart --no-pub
+
+      - name: Verify branding in web build
+        run: |
+          python - <<'PY'
+          from PIL import Image
+          from pathlib import Path
+          for name, expected in [
+              ('build/web/icons/life-assistant-192-v8.png', (192, 192)),
+              ('build/web/icons/life-assistant-512-v8.png', (512, 512)),
+              ('build/web/branding/life-assistant-hero-v8.png', (1024, 1024)),
+          ]:
+              path = Path(name)
+              assert path.is_file() and path.stat().st_size > 4000, name
+              with Image.open(path) as image:
+                  assert image.format == 'PNG' and image.size == expected, (name, image.size)
+          PY
+          grep -Fq '/manifest-v6.json' build/web/index.html
+          grep -Fq '/icons/life-assistant-192-v8.png' build/web/manifest-v6.json
+          grep -Fq '/icons/life-assistant-512-v8.png' build/web/manifest-v6.json
+
+  backend:
