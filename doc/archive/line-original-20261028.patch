+_DATE_YEAR_MONTH = re.compile(
+    r"(?<![0-9])(?P<roc>民國\s*)?(?P<year>[0-9]{3,4})\s*"
+    r"(?:年|[./-])\s*(?P<month>[0-9]{1,2})\s*月?(?![0-9/.-])"
+)
+_DATE_MONTH_DAY = re.compile(
+    r"(?<![0-9])(?P<month>[0-9]{1,2})\s*(?:月|[/-])\s*"
+    r"(?P<day>[0-9]{1,2})\s*日?(?![0-9])"
