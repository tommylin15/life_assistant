+          # Python scripts
+          python -m py_compile \
+            backend/scripts/run_drive_knowledge_runtime_acceptance.py \
+            backend/scripts/run_drive_google_integration_acceptance.py \
+            backend/scripts/run_curated_pool_runtime_acceptance.py \
+            .github/scripts/v3_firebase_error.py \
+            .github/scripts/v3_gcs_object_inventory.py \
+            .github/scripts/v3_image_identity.py \
+            .github/scripts/v3_curated_handoff_alignment.py \
+            .github/scripts/v3_revision_retention.py \
+            .github/scripts/v3_gcp_inventory.py \
+            .github/scripts/v3_free_event_retirement_readback.py \
+            .github/scripts/v3_staging_gate.py
+
+      - name: Run deployment script tests
+        run: |
+          python -m unittest \
+            tests/test_v3_verify_preview.py \
+            tests/test_v3_firebase_error.py \
+            tests/test_v3_image_identity.py \
+            tests/test_v3_curated_handoff_alignment.py \
+            tests/test_v3_revision_retention.py \
+            tests/test_life_cloud_run_retirement.py \
+            tests/test_v3_staging_gate.py \
+            tests/test_v3_workflow_consolidation.py \
+            tests/test_v3_auto_production_hosting_workflow.py \
