+                        "message": "Explicit user confirmation is required",
+                        "request_id": request_id,
+                    }
+                },
+            )
+            response.headers["X-Request-ID"] = request_id
+            return response
+
+        response = await call_next(request)
+        response.headers["X-Request-ID"] = request_id
+        return response
+    finally:
+        reset_request_id(token)
